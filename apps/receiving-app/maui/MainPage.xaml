<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackNTrash.ReceivingApp.MainPage"
             BackgroundColor="#0f1420"
             Title="TrackNTrash Receiving">

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16" MaximumWidthRequest="640" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="2">
                <Label Text="TrackNTrash · Store Receiving" FontSize="22" FontAttributes="Bold" TextColor="#e7ecf6" />
                <Label x:Name="lblConn" Text="Connecting…" FontSize="13" TextColor="#9aa6ba" />
            </VerticalStackLayout>

            <Border x:Name="banner" IsVisible="False" StrokeThickness="0" Padding="14" StrokeShape="RoundRectangle 8">
                <Label x:Name="lblBanner" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </Border>

            <!-- 0. Sign in -->
            <Border x:Name="cardAuth" BackgroundColor="#161d2b" Stroke="#28313f" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="0 · SIGN IN" FontSize="12" TextColor="#5f93ff" FontAttributes="Bold" />
                    <Label x:Name="lblAuth" Text="The tracking API only accepts scans from a signed-in user." FontSize="12" TextColor="#9aa6ba" />
                    <Label Text="LANGUAGE" FontSize="11" TextColor="#5f93ff" FontAttributes="Bold" />
                    <Picker x:Name="pickLang" TextColor="#e7ecf6" TitleColor="#9aa6ba"
                            SelectedIndexChanged="OnLanguageChanged" />
                    <Entry x:Name="txtUser" Placeholder="Username" Text="admin" TextColor="#e7ecf6" />
                    <Entry x:Name="txtPass" Placeholder="Password" IsPassword="True" TextColor="#e7ecf6" Completed="OnSignIn" />
                    <Button x:Name="btnSignIn" Text="Sign in" Clicked="OnSignIn" BackgroundColor="#2f66e6" TextColor="White" />
                    <Button x:Name="btnSignOut" Text="Sign out" Clicked="OnSignOut" IsVisible="False" BackgroundColor="#2b3a5c" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Everything below needs a token, so it stays disabled until sign-in succeeds. -->
            <VerticalStackLayout x:Name="workArea" Spacing="16" IsEnabled="False" Opacity="0.45">

            <!-- 1. Delivery setup (ASN) -->
            <Border BackgroundColor="#161d2b" Stroke="#28313f" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1 · DELIVERY (ASN)" FontSize="12" TextColor="#5f93ff" FontAttributes="Bold" />
                    <Entry x:Name="txtTray" Placeholder="Tray QR" Text="TRAY-RCV-01" TextColor="#e7ecf6" />
                    <Entry x:Name="txtStore" Placeholder="Store code" Text="S-LDN1" TextColor="#e7ecf6" />
                    <Entry x:Name="txtExpected" Placeholder="Expected carton payloads (comma-separated)" Text="C-A, C-B, C-C" TextColor="#e7ecf6" />
                    <Button x:Name="btnStart" Text="Set up &amp; start receiving" Clicked="OnStart" BackgroundColor="#2f66e6" TextColor="White" />
                    <Label x:Name="lblSession" Text="" FontSize="13" TextColor="#9aa6ba" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Scan cartons -->
            <Border BackgroundColor="#161d2b" Stroke="#28313f" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2 · RECEIVE CARTONS" FontSize="12" TextColor="#5f93ff" FontAttributes="Bold" />
                    <Label Text="Scan a carton then Enter. Not on the list → OVER (shows the correct store)."
                           FontSize="12" TextColor="#9aa6ba" />
                    <Entry x:Name="txtScan" Placeholder="Scan carton payload then Enter…" Completed="OnScan" TextColor="#e7ecf6" />
                    <Button Text="📷 Scan carton with camera" Clicked="OnScanCamera" BackgroundColor="#2b3a5c" TextColor="White" />
                    <Label x:Name="lblTally" Text="0 / 0 received" FontSize="16" FontAttributes="Bold" TextColor="#43b477" />
                </VerticalStackLayout>
            </Border>

            <!-- 2b. Damaged carton -->
            <Border BackgroundColor="#161d2b" Stroke="#28313f" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2b · DAMAGED CARTON" FontSize="12" TextColor="#f2a33c" FontAttributes="Bold" />
                    <Label Text="A carton that arrived broken needs a photo — a damage claim without evidence cannot be settled with the carrier."
                           FontSize="12" TextColor="#9aa6ba" />
                    <Entry x:Name="txtDamaged" Placeholder="Carton payload" TextColor="#e7ecf6" />
                    <Entry x:Name="txtPhoto" Placeholder="Damage photo reference (blob URI)" Text="blob://damage/" TextColor="#e7ecf6" />
                    <Button x:Name="btnDamaged" Text="Flag as damaged" Clicked="OnFlagDamaged" BackgroundColor="#b4762a" TextColor="White" />
                    <Label x:Name="lblDamaged" Text="" FontSize="13" TextColor="#9aa6ba" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Complete (POD) -->
            <Border BackgroundColor="#161d2b" Stroke="#28313f" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3 · PROOF OF DELIVERY" FontSize="12" TextColor="#5f93ff" FontAttributes="Bold" />
                    <Entry x:Name="txtReceiver" Placeholder="Receiver name" Text="Sam Store" TextColor="#e7ecf6" />
                    <Button x:Name="btnComplete" Text="Complete delivery" Clicked="OnComplete" IsEnabled="False"
                            BackgroundColor="#43b477" TextColor="White" HeightRequest="46" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#131a27" Stroke="#28313f" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ACTIVITY" FontSize="12" TextColor="#9aa6ba" FontAttributes="Bold" />
                    <Label x:Name="lblLog" Text="Ready." FontSize="12" TextColor="#9aa6ba" />
                </VerticalStackLayout>
            </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
