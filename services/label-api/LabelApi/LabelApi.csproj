<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrackNTrash.LabelApi</RootNamespace>
    <AssemblyName>TrackNTrash.LabelApi</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform QR generation (PNG via PngByteQRCode, SVG via SvgQRCode) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- SQL-backed serial/SSCC sequence provider -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
